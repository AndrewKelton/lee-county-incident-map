# Neon Postgres connection string (pooled endpoint). Leave unset to use local
# SQLite databases under ./data instead.
DATABASE_URL=

# Sent with every outbound request (county API + geocoders ask for a real contact).
USER_AGENT="LeeCountyIncidentMap/1.0 (senior-design; you@example.edu)"

# S3 write buffer for the live feeds (fetch Lambdas write, flush drains).
S3_BUFFER_BUCKET=

# Optional: where local SQLite state lives (default: ./data relative to CWD).
# LEECAD_DATA_DIR=/home/ec2-user/sheriff_activity/data

# Optional: override the crawl seed list (default: ./data/seeds/street_queries.txt).
# LEECAD_STREET_QUERIES=